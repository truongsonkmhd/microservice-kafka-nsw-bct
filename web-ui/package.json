{
  "name": "web-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve nsw-web",
    "start:nsw": "ng serve nsw-web --port 4200",
    "start:bct": "ng serve bct-web --port 4201",
    "build": "ng build nsw-web && ng build bct-web",
    "build:nsw": "ng build nsw-web",
    "build:bct": "ng build bct-web",
    "watch": "ng build nsw-web --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
